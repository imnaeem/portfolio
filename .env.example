# Mail (SMTP)
MAILER_HOST=
MAILER_EMAIL=
MAILER_EMAIL_PASSWORD=
RECEIVER_EMAIL=

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# The site key is public and inlined at build time by Next.js.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAGWFQmpGHTvbPQx0
# Server-side secret. Keep it out of git and set it in your hosting provider.
TURNSTILE_SECRET=
# Optional but recommended: comma-separated hostnames Cloudflare reports for this
# site (no protocol, no path). When set, submissions from other hostnames are rejected.
# Production must not include localhost; use a separate local value when testing.
TURNSTILE_HOSTNAMES=imnaeem.dev,www.imnaeem.dev
